# Banco de dados (local / desenvolvimento)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=keys-forge

# Segredo do JWT - gere um valor longo e aleatorio, NUNCA reutilize este exemplo
# Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=defina_uma_chave_secreta_forte_aqui

PORT=3001

# Credenciais usadas nos testes (preencha com valores proprios)
TEST_USER_EMAIL=seu_email_de_teste@email.com
TEST_USER_PASSWORD=sua_senha_de_teste
